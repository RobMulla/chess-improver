# Chess Platform Usernames
CHESS_COM_USERNAME=your_chess_com_username
LICHESS_USERNAME=your_lichess_username

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here  # Optional for YouTube recommendations

# Stockfish Engine Path
STOCKFISH_PATH=/usr/local/bin/stockfish  # Update to your Stockfish installation path

# Database
DATABASE_URL=sqlite:///chess_improver.db

# Analysis Settings
STOCKFISH_DEPTH=20  # Analysis depth (higher = slower but more accurate)
STOCKFISH_TIME_MS=1000  # Time per position in milliseconds
MISTAKE_THRESHOLD_CP=50  # Centipawn loss for mistake
BLUNDER_THRESHOLD_CP=150  # Centipawn loss for blunder

# Daily Plan Settings
TASKS_PER_DAY=5
STUDY_DURATION_MINUTES=30
